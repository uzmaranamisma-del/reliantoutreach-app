NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_SSL=false
AUTH_SECRET=
# 32 random bytes encoded as 64 hex characters. Never rotate without re-encrypting stored records.
ENCRYPTION_KEY=
MANYREACH_API_BASE_URL=https://api.manyreach.com/api/v2
MANYREACH_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ReliantOutreach
CRON_SECRET=
INVITATION_EXPIRY_HOURS=48
AUDIT_RETENTION_DAYS=90
API_LOG_RETENTION_DAYS=7
POLL_INBOX_SECONDS=15
POLL_CAMPAIGNS_SECONDS=25
POLL_DASHBOARD_SECONDS=45
LOG_LEVEL=warn
# Only for one-time CLI bootstrap; remove after use.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=
